{
  "name": "setup-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=22.17" },
  "dependencies": { "three": "0.187.0" },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/three": "^0.187.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  },
  "imports": { "#lib": "./src/lib/index.js", "#lib/*": "./src/lib/*" }
}
